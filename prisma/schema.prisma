generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum MediaType {
  TV_SHOW
  TV_EPISODE
  MOVIE
  GAME
  BOARD_GAME
  MUSIC_TRACK
}

enum LogSource {
  MANUAL
  API
}

enum TagLinkSource {
  MANUAL
  PROVIDER
}

enum MergeRedirectIdentityKind {
  CANONICAL
  EXTERNAL_ALIAS
}

model User {
  id              String                   @id @default(cuid())
  username        String                   @unique
  passwordHash    String
  apiKey          String                   @unique @default(cuid())
  isAdmin         Boolean                  @default(false)
  createdAt       DateTime                 @default(now())
  metadataKeys    UserMetadataKey[]
  mediaItems      MediaItem[]              @relation("MediaItemOwner")
  mediaAliases    MediaAlias[]
  externalIds     MediaExternalId[]
  externalAliases MediaExternalAlias[]
  tags            Tag[]
  mediaItemTags   MediaItemTag[]
  mergeRedirects  MediaItemMergeRedirect[]
  logEntries      LogEntry[]
  settings        UserSetting[]
  apiKeys         ApiKey[]
}

model UserMetadataKey {
  id       String @id @default(cuid())
  userId   String
  provider String
  keyEnc   String
  keyIv    String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model MediaItem {
  id              String                   @id @default(cuid())
  type            MediaType
  title           String
  sortTitle       String
  isSkeleton      Boolean                  @default(false)
  createdByUserId String
  parentId        String?
  seasonNumber    Int?
  episodeNumber   Int?
  description     String?
  imageUrl        String?
  imageSourceUrl  String?
  year            Int?
  duration        Int?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  createdByUser   User                     @relation("MediaItemOwner", fields: [createdByUserId], references: [id], onDelete: Cascade)
  parent          MediaItem?               @relation("EpisodeShow", fields: [parentId], references: [id], onDelete: SetNull)
  episodes        MediaItem[]              @relation("EpisodeShow")
  aliases         MediaAlias[]
  externalIds     MediaExternalId[]
  externalAliases MediaExternalAlias[]
  mediaTags       MediaItemTag[]
  logEntries      LogEntry[]
  cachedImages    CachedImage[]
  mergeRedirects  MediaItemMergeRedirect[] @relation("MergeRedirectTarget")

  @@unique([parentId, seasonNumber, episodeNumber])
  @@index([createdByUserId])
}

model MediaItemMergeRedirect {
  id                String                           @id @default(cuid())
  userId            String
  sourceMediaItemId String                           @unique
  sourceTitle       String
  targetMediaItemId String
  createdAt         DateTime                         @default(now())
  user              User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetMediaItem   MediaItem                        @relation("MergeRedirectTarget", fields: [targetMediaItemId], references: [id], onDelete: Cascade)
  identities        MediaItemMergeRedirectIdentity[]

  @@index([userId, targetMediaItemId])
}

model MediaItemMergeRedirectIdentity {
  id         String                    @id @default(cuid())
  redirectId String
  kind       MergeRedirectIdentityKind
  namespace  String
  externalId String
  redirect   MediaItemMergeRedirect    @relation(fields: [redirectId], references: [id], onDelete: Cascade)

  @@unique([redirectId, kind, namespace, externalId])
}

model Tag {
  id            String         @id @default(cuid())
  userId        String
  normalizedKey String
  displayName   String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaItemTags MediaItemTag[]

  @@unique([userId, normalizedKey])
  @@index([userId, displayName])
}

model MediaItemTag {
  id                String        @id @default(cuid())
  userId            String
  mediaItemId       String
  tagId             String
  source            TagLinkSource
  providerNamespace String        @default("")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaItem         MediaItem     @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  tag               Tag           @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaItemId, tagId, source, providerNamespace])
  @@index([userId, mediaItemId])
  @@index([userId, tagId])
}

model MediaAlias {
  id          String    @id @default(cuid())
  userId      String
  mediaItemId String
  alias       String
  mediaItem   MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, alias])
  @@index([mediaItemId])
}

model MediaExternalId {
  id          String    @id @default(cuid())
  userId      String
  mediaItemId String
  provider    String
  externalId  String
  mediaItem   MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, externalId])
  @@index([mediaItemId])
}

model MediaExternalAlias {
  id                String    @id @default(cuid())
  userId            String
  mediaItemId       String
  providerNamespace String
  externalId        String
  createdAt         DateTime  @default(now())
  mediaItem         MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, providerNamespace, externalId])
  @@index([mediaItemId])
}

model LogEntry {
  id          String    @id @default(cuid())
  userId      String
  mediaItemId String
  loggedAt    DateTime
  duration    Int?
  description String?
  platform    String?
  playerCount Int?
  won         Boolean?
  source      LogSource @default(MANUAL)
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaItem   MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
  @@index([userId, mediaItemId, loggedAt])
}

model UserSetting {
  id     String @id @default(cuid())
  userId String
  key    String
  value  String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model ApiKey {
  id        String   @id @default(cuid())
  userId    String
  name      String?
  keyHash   String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CachedImage {
  id          String    @id @default(cuid())
  mediaItemId String
  localPath   String
  sourceUrl   String
  createdAt   DateTime  @default(now())
  mediaItem   MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)

  @@unique([mediaItemId, sourceUrl])
}
