<section class="rounded-lg border border-border-subtle bg-bg-base p-4">
  <h3 class="font-heading text-base font-bold">Confirm replacement</h3>
  <div class="mt-3 grid gap-3 sm:grid-cols-2">
    <div class="rounded-lg border border-border-subtle bg-bg-elevated p-3">
      <div class="text-xs uppercase tracking-wide text-text-secondary">Current</div>
      <div class="mt-1 font-heading text-sm font-semibold">{{item.title}}</div>
    </div>
    <div class="rounded-lg border border-border-subtle bg-bg-elevated p-3">
      <div class="text-xs uppercase tracking-wide text-text-secondary">Replacement</div>
      <div class="mt-1 font-heading text-sm font-semibold">{{proposed.title}}</div>
      {{#if proposed.year}}<div class="text-xs text-text-secondary">{{proposed.year}}</div>{{/if}}
    </div>
  </div>
  <form method="POST" action="{{submitUrl}}" class="mt-4 flex items-center gap-3">
    <input type="hidden" name="_csrf" value="{{@root.csrfToken}}" />
    <input type="hidden" name="provider" value="{{provider}}" />
    <input type="hidden" name="externalId" value="{{externalId}}" />
    <button type="submit"
      class="inline-flex items-center gap-2 rounded-lg bg-text-primary px-4 py-2 font-heading text-sm font-semibold text-bg-base active:scale-[0.98]">
      Apply replacement
    </button>
  </form>
</section>
