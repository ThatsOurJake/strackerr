{{#if missingKey}}
<p class="rounded-lg border border-dashed border-border-subtle p-3 text-sm text-text-secondary">No API key configured.
</p>
{{else}}
{{#if error}}
<p class="rounded-lg border border-red-500 bg-red-950 p-3 text-sm text-red-300">{{error}}</p>
{{/if}}
{{#if hasResults}}
<ul class="divide-y divide-border-subtle overflow-hidden rounded-lg border border-border-subtle bg-bg-base">
  {{#each results}}
  <li>
    <form method="POST" action="{{../submitUrl}}" hx-post="{{../submitUrl}}" hx-target="{{../resultsTarget}}"
      hx-swap="innerHTML">
      <input type="hidden" name="_csrf" value="{{@root.csrfToken}}" />
      <input type="hidden" name="provider" value="{{../provider}}" />
      <input type="hidden" name="externalId" value="{{this.externalId}}" />
      <button type="submit"
        class="flex w-full items-center gap-3 p-3 text-left hover:bg-bg-elevated focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-text-primary">
        {{#if (preferredImageUrl this.imageUrl this.imageSourceUrl)}}
        <img data-image-fallback src="{{preferredImageUrl this.imageUrl this.imageSourceUrl}}" alt="" loading="lazy"
          referrerpolicy="no-referrer" class="h-14 w-10 shrink-0 rounded object-cover" />
        <span
          class="hidden h-14 w-10 shrink-0 items-center justify-center rounded bg-bg-elevated text-text-secondary"><i
            data-lucide="image" class="h-4 w-4"></i></span>
        {{else}}
        <span class="flex h-14 w-10 shrink-0 items-center justify-center rounded bg-bg-elevated text-text-secondary"><i
            data-lucide="image" class="h-4 w-4"></i></span>
        {{/if}}
        <span class="min-w-0 flex-1">
          <span class="block truncate font-heading text-sm font-semibold">{{this.title}}</span>
          {{#if this.year}}<span class="mt-0.5 block text-xs text-text-secondary">{{this.year}}</span>{{/if}}
          {{#if this.description}}<span
            class="mt-1 block truncate text-xs text-text-secondary">{{this.description}}</span>{{/if}}
        </span>
        <span class="inline-flex shrink-0 items-center gap-1 font-heading text-xs font-semibold">Review result<i
            data-lucide="arrow-right" class="h-4 w-4"></i></span>
      </button>
    </form>
  </li>
  {{/each}}
</ul>
{{else}}
{{#if searched}}<p class="rounded-lg border border-dashed border-border-subtle p-4 text-sm text-text-secondary">No
  results found.</p>{{/if}}
{{/if}}
{{/if}}
