<section class="rounded-lg border border-border-subtle bg-bg-surface p-4" aria-labelledby="identify-heading">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h2 id="identify-heading" class="font-heading text-lg font-bold">{{actionLabel}} {{item.title}}</h2>
      <p class="mt-1 text-xs uppercase text-text-secondary">Searching {{providerLabel}}</p>
      {{#unless item.isSkeleton}}<p class="mt-2 text-xs text-text-secondary">Current identity: {{currentIdentity}}</p>
      {{/unless}}
    </div>
    <button type="button" aria-label="Close identify panel" title="Close" data-close-identify-panel
      class="rounded-lg p-2 text-text-secondary hover:bg-bg-elevated hover:text-text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-text-primary">
      <i data-lucide="x" class="h-4 w-4"></i>
    </button>
  </div>

  {{#if missingKey}}
  <p class="mt-4 rounded-lg border border-dashed border-border-subtle bg-bg-elevated p-4 text-sm text-text-secondary">
    No API key configured for this provider. Add one in <a href="/settings"
      class="text-text-primary underline">Settings</a>.
  </p>
  {{else}}
  <div class="relative mt-4">
    <i data-lucide="search" class="pointer-events-none absolute left-3 top-2.5 h-4 w-4 text-text-secondary"></i>
    <input type="search" name="q" minlength="3" autocomplete="off" value="{{item.title}}"
      hx-get="/collection/{{typeSlug}}/{{item.id}}/identify/search" hx-trigger="input changed delay:300ms, load"
      hx-target="#identify-results-{{item.id}}" hx-indicator="#identify-spinner-{{item.id}}"
      class="w-full rounded-lg border border-border-subtle bg-bg-elevated py-2 pl-10 pr-10 text-sm focus:outline-none focus:ring-2 focus:ring-text-primary" />
    <span id="identify-spinner-{{item.id}}"
      class="htmx-indicator absolute right-3 top-2.5 h-4 w-4 animate-spin rounded-full border-2 border-text-secondary border-t-transparent"></span>
  </div>
  <p class="mt-2 text-xs text-text-secondary">
    Try <span class="font-medium text-text-primary">artist:"Queen" title:"Bohemian Rhapsody" year:"1975"</span> or
    <span class="font-medium text-text-primary">id:12345</span>. The id uses the provider shown above. Use either
    structured syntax or plain text search.
  </p>
  <div id="identify-results-{{item.id}}" class="mt-3"></div>
  {{/if}}
</section>
