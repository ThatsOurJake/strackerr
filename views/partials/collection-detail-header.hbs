<a href="/collection" class="inline-flex items-center gap-1.5 text-sm text-text-secondary hover:text-text-primary"><i
    data-lucide="arrow-left" class="h-4 w-4"></i>Back to collection</a>
<header class="mt-6 grid gap-6 border-b border-border-subtle pb-8 sm:grid-cols-[10rem_minmax(0,1fr)]">
  <div class="aspect-[2/3] overflow-hidden rounded-lg bg-type-{{accent}}/15">
    {{#if imageUrl}}<img src="{{imageUrl}}" alt="" class="h-full w-full object-cover" />{{else}}<span
      class="flex h-full items-center justify-center text-type-{{accent}}"><i data-lucide="{{icon}}"
        class="h-12 w-12"></i></span>{{/if}}
  </div>
  <div class="self-end">
    <span
      class="inline-block rounded-full border border-type-{{accent}}/40 bg-type-{{accent}}/15 px-2 py-0.5 font-heading text-[11px] font-semibold uppercase tracking-wide text-type-{{accent}}">{{label}}</span>
    {{#if isSkeleton}}<span
      class="ml-1 inline-block rounded-full border border-dashed border-border-subtle bg-bg-elevated px-2 py-0.5 font-heading text-[11px] font-semibold uppercase tracking-wide text-text-secondary">Unidentified</span>{{/if}}
    <h1 class="mt-3 font-heading text-3xl font-extrabold tracking-tight">{{title}}</h1>
    {{#if artist}}<p class="mt-1 text-base text-text-secondary">{{artist}}</p>{{/if}}
    {{#if year}}<p class="mt-1 text-sm text-text-secondary">{{year}}</p>{{/if}}
    {{#if description}}<p class="mt-4 max-w-3xl text-sm leading-6 text-text-secondary">{{description}}</p>{{/if}}
    {{#if identifyUrl}}<a href="{{identifyUrl}}"
      class="mt-5 inline-flex items-center gap-2 rounded-lg bg-type-{{accent}} px-4 py-2 font-heading text-sm font-semibold text-black active:scale-[0.98]"><i
        data-lucide="search" class="h-4 w-4"></i>Identify</a>{{/if}}
  </div>
</header>
