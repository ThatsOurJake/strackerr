<div class="border-t border-border-subtle pt-6">
  <h2 class="font-heading text-xl font-bold">Log {{typeLabel}}</h2>
  {{#if error}}
  <p class="mt-4 rounded-lg border border-red-500 bg-red-950 p-3 text-sm text-red-300">{{error}}</p>
  {{/if}}

  <form method="POST" action="/add" class="mt-5 space-y-4">
    <input type="hidden" name="type" value="{{type}}" />
    {{#if mediaItemId}}<input type="hidden" name="mediaItemId" value="{{mediaItemId}}" />{{/if}}
    {{#if defaultDuration}}<input type="hidden" name="defaultDuration" value="{{defaultDuration}}" />{{/if}}

    <div>
      <label for="add-title" class="mb-1 block font-heading text-sm font-semibold text-text-secondary">{{#if isTvEpisode}}Show title{{else}}Title{{/if}}</label>
      <input id="add-title" name="title" value="{{title}}" required {{#if mediaItemId}}readonly{{/if}}
        class="w-full rounded-lg border border-border-subtle bg-bg-elevated px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-text-primary read-only:text-text-secondary" />
    </div>

    {{#if isTvEpisode}}
    <div class="grid grid-cols-2 gap-3">
      <div>
        <label for="season-number" class="mb-1 block font-heading text-sm font-semibold text-text-secondary">Season</label>
        <input id="season-number" name="seasonNumber" type="number" min="1" step="1" value="{{seasonNumber}}" required
          class="w-full rounded-lg border border-border-subtle bg-bg-elevated px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-type-tv" />
      </div>
      <div>
        <label for="episode-number" class="mb-1 block font-heading text-sm font-semibold text-text-secondary">Episode</label>
        <input id="episode-number" name="episodeNumber" type="number" min="1" step="1" value="{{episodeNumber}}" required
          class="w-full rounded-lg border border-border-subtle bg-bg-elevated px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-type-tv" />
      </div>
    </div>
    {{/if}}

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label for="logged-at" class="mb-1 block font-heading text-sm font-semibold text-text-secondary">Date</label>
        <input id="logged-at" name="loggedAt" type="date" value="{{loggedAt}}" required
          class="w-full rounded-lg border border-border-subtle bg-bg-elevated px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-text-primary" />
      </div>
      <div>
        <label for="duration" class="mb-1 block font-heading text-sm font-semibold text-text-secondary">Duration (minutes){{#if isGame}} *{{/if}}</label>
        <input id="duration" name="duration" type="number" min="1" step="1" value="{{duration}}" {{#if isGame}}required{{/if}}
          class="w-full rounded-lg border border-border-subtle bg-bg-elevated px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-text-primary" />
        {{#if defaultDuration}}<p class="mt-1 text-xs text-text-secondary">Defaults to {{defaultDuration}} min</p>{{/if}}
      </div>
    </div>

    {{#if isGame}}
    <div>
      <label for="platform" class="mb-1 block font-heading text-sm font-semibold text-text-secondary">Platform</label>
      <select id="platform" name="platform" required class="w-full rounded-lg border border-border-subtle bg-bg-elevated px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-type-game">
        <option value="">Select platform</option>
        <option value="Steam" {{#if (eq platform 'Steam')}}selected{{/if}}>Steam</option>
        <option value="Epic" {{#if (eq platform 'Epic')}}selected{{/if}}>Epic</option>
        <option value="GOG" {{#if (eq platform 'GOG')}}selected{{/if}}>GOG</option>
        <option value="Xbox" {{#if (eq platform 'Xbox')}}selected{{/if}}>Xbox</option>
        <option value="PlayStation" {{#if (eq platform 'PlayStation')}}selected{{/if}}>PlayStation</option>
        <option value="Other" {{#if (eq platform 'Other')}}selected{{/if}}>Other</option>
      </select>
    </div>
    {{/if}}

    {{#if isBoardGame}}
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label for="player-count" class="mb-1 block font-heading text-sm font-semibold text-text-secondary">Player count</label>
        <input id="player-count" name="playerCount" type="number" min="1" step="1" value="{{playerCount}}"
          class="w-full rounded-lg border border-border-subtle bg-bg-elevated px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-type-boardgame" />
      </div>
      <div>
        <label for="won" class="mb-1 block font-heading text-sm font-semibold text-text-secondary">Outcome</label>
        <select id="won" name="won" class="w-full rounded-lg border border-border-subtle bg-bg-elevated px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-type-boardgame">
          <option value="">Not recorded</option>
          <option value="true" {{#if (eq won 'true')}}selected{{/if}}>Won</option>
          <option value="false" {{#if (eq won 'false')}}selected{{/if}}>Did not win</option>
        </select>
      </div>
    </div>
    {{/if}}

    <div>
      <label for="notes" class="mb-1 block font-heading text-sm font-semibold text-text-secondary">Notes</label>
      <textarea id="notes" name="notes" rows="3" class="w-full resize-y rounded-lg border border-border-subtle bg-bg-elevated px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-text-primary">{{notes}}</textarea>
    </div>

    <button type="submit" class="inline-flex items-center gap-2 rounded-lg bg-text-primary px-4 py-2 font-heading text-sm font-semibold text-bg-base active:scale-[0.98] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-text-primary">
      <i data-lucide="plus" class="h-4 w-4"></i>
      Add to history
    </button>
  </form>
</div>