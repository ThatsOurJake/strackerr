<div class="mx-auto max-w-5xl">
  <h1 class="font-heading text-3xl font-extrabold tracking-tight">{{#if query}}Results for
    '{{query}}'{{else}}Search{{/if}}</h1>
  {{#if groups.length}}
  <div class="mt-8 space-y-8">
    {{#each groups}}
    <section>
      <h2 class="font-heading text-xl font-bold">{{label}}</h2>
      <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {{#each results}}
        <a href="/collection/{{path}}/{{id}}"
          class="rounded-lg border border-border-subtle bg-bg-surface p-4 hover:bg-bg-elevated">
          <div class="font-heading font-semibold">{{title}}</div>
          {{#if subtitle}}<div class="mt-1 text-sm text-text-secondary">{{subtitle}}</div>{{/if}}
          <div class="mt-2 text-xs uppercase tracking-wide text-text-secondary">{{label}}</div>
        </a>
        {{/each}}
      </div>
    </section>
    {{/each}}
  </div>
  {{else}}
  {{#if searched}}<div class="mt-8">{{> empty_search}}</div>{{/if}}
  {{/if}}
</div>
