<div class="mx-auto max-w-5xl">
  {{> collection_detail_header}}
  <section class="grid grid-cols-2 border-b border-border-subtle py-6">
    <div>
      <div class="font-heading text-2xl font-extrabold">{{episodesWatched}}</div>
      <div class="text-xs text-text-secondary">Episodes watched</div>
    </div>
    <div>
      <div class="font-heading text-2xl font-extrabold">{{episodeDuration}}</div>
      <div class="text-xs text-text-secondary">Time watched</div>
    </div>
  </section>
  <section class="py-8">
    <h2 class="font-heading text-xl font-bold">Episodes</h2>
    {{#if seasons.length}}<div class="mt-4 divide-y divide-border-subtle border-y border-border-subtle">{{#each
      seasons}}
      <details class="group" {{#if @first}}open{{/if}}>
        <summary class="flex cursor-pointer list-none items-center justify-between py-4 font-heading font-semibold">
          <span>Season {{seasonNumber}}</span><i data-lucide="chevron-down" class="h-4 w-4 group-open:rotate-180"></i>
        </summary>
        <div class="pb-4">{{#each episodes}}<div
            class="grid grid-cols-[3rem_minmax(0,1fr)_auto] items-center gap-3 border-t border-border-subtle px-2 py-3 {{#unless watched}}opacity-45{{/unless}}">
            <span class="font-heading text-xs font-semibold text-type-tv">E{{episodeNumber}}</span><span
              class="min-w-0 truncate text-sm">{{title}}</span><span
              class="text-right text-xs text-text-secondary">{{watchCount}} watched{{#if watched}} ·
              {{totalDuration}}{{/if}}</span></div>{{/each}}</div>
      </details>{{/each}}
    </div>{{else}}<p class="mt-4 text-sm text-text-secondary">No cached episodes are available yet.</p>{{/if}}
  </section>
</div>
