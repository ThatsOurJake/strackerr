<div class="mx-auto max-w-5xl">
  <h1 class="mb-6 text-display font-heading">Settings</h1>

  {{#if success}}
  <div
    class="flash-message mb-6 rounded border-l-4 border-l-type-game bg-green-900 bg-opacity-20 p-4 text-body text-text-primary"
    role="status">
    {{success}}
    {{#if newApiKey}}
    <div class="mt-3 rounded bg-bg-base p-3 font-mono text-body">
      <div class="mb-2 text-text-secondary">API key</div>
      <div class="break-all text-type-tv">{{newApiKey}}</div>
    </div>
    {{/if}}
  </div>
  {{/if}}

  {{#if error}}
  <div
    class="flash-message mb-6 rounded border-l-4 border-l-red-500 bg-red-900 bg-opacity-20 p-4 text-body text-text-primary"
    role="alert">
    {{error}}
  </div>
  {{/if}}

  <nav class="mb-6 overflow-x-auto border-b border-border" aria-label="Settings sections">
    <div class="flex min-w-max gap-1" role="tablist">
      <a href="/settings?tab=account" role="tab"
        aria-selected="{{#if (eq activeTab 'account')}}true{{else}}false{{/if}}"
        class="border-b-2 px-4 py-3 font-heading text-body font-semibold focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-text-primary {{#if (eq activeTab 'account')}}border-type-tv text-text-primary{{else}}border-transparent text-text-secondary hover:bg-bg-elevated hover:text-text-primary{{/if}}">
        Account
      </a>
      <a href="/settings?tab=providers" role="tab"
        aria-selected="{{#if (eq activeTab 'providers')}}true{{else}}false{{/if}}"
        class="border-b-2 px-4 py-3 font-heading text-body font-semibold focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-text-primary {{#if (eq activeTab 'providers')}}border-type-game text-text-primary{{else}}border-transparent text-text-secondary hover:bg-bg-elevated hover:text-text-primary{{/if}}">
        Metadata Providers
      </a>
      <a href="/settings?tab=maintenance" role="tab"
        aria-selected="{{#if (eq activeTab 'maintenance')}}true{{else}}false{{/if}}"
        class="border-b-2 px-4 py-3 font-heading text-body font-semibold focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-text-primary {{#if (eq activeTab 'maintenance')}}border-type-music text-text-primary{{else}}border-transparent text-text-secondary hover:bg-bg-elevated hover:text-text-primary{{/if}}">
        Maintenance
      </a>
    </div>
  </nav>

  {{#if (eq activeTab 'account')}}
  <section aria-labelledby="account-heading" class="space-y-6">
    <div class="rounded border border-border bg-bg-surface p-4">
      <h2 id="account-heading" class="mb-4 text-heading font-heading">Account</h2>
      <div class="text-body">
        <span class="text-text-secondary">Username</span>
        <span class="ml-2 font-medium text-text-primary">{{username}}</span>
      </div>
    </div>

    <div class="rounded border border-border bg-bg-surface p-4">
      <h2 class="mb-2 text-heading font-heading">Change Password</h2>
      <form method="POST" action="/settings/password" class="max-w-xl space-y-4">
        <input type="hidden" name="_csrf" value="{{csrfToken}}" />
        <div>
          <label for="currentPassword" class="mb-1 block text-subheading font-heading text-text-secondary">Current
            password</label>
          <input type="password" id="currentPassword" name="currentPassword" required autocomplete="current-password"
            aria-describedby="currentPasswordError"
            class="w-full rounded border bg-bg-elevated px-3 py-2 text-body text-text-primary focus:outline-none focus:ring-2 focus:ring-type-tv {{#if passwordErrors.currentPassword}}border-red-500{{else}}border-border{{/if}}" />
          {{#if passwordErrors.currentPassword}}
          <p id="currentPasswordError" class="mt-1 text-meta text-red-400">{{passwordErrors.currentPassword}}</p>
          {{/if}}
        </div>
        <div>
          <label for="accountNewPassword" class="mb-1 block text-subheading font-heading text-text-secondary">New
            password</label>
          <input type="password" id="accountNewPassword" name="newPassword" required minlength="8"
            autocomplete="new-password" aria-describedby="newPasswordError"
            class="w-full rounded border bg-bg-elevated px-3 py-2 text-body text-text-primary focus:outline-none focus:ring-2 focus:ring-type-tv {{#if passwordErrors.newPassword}}border-red-500{{else}}border-border{{/if}}" />
          {{#if passwordErrors.newPassword}}
          <p id="newPasswordError" class="mt-1 text-meta text-red-400">{{passwordErrors.newPassword}}</p>
          {{/if}}
        </div>
        <div>
          <label for="accountConfirmPassword"
            class="mb-1 block text-subheading font-heading text-text-secondary">Confirm new password</label>
          <input type="password" id="accountConfirmPassword" name="confirmPassword" required autocomplete="new-password"
            aria-describedby="confirmPasswordError"
            class="w-full rounded border bg-bg-elevated px-3 py-2 text-body text-text-primary focus:outline-none focus:ring-2 focus:ring-type-tv {{#if passwordErrors.confirmPassword}}border-red-500{{else}}border-border{{/if}}" />
          {{#if passwordErrors.confirmPassword}}
          <p id="confirmPasswordError" class="mt-1 text-meta text-red-400">{{passwordErrors.confirmPassword}}</p>
          {{/if}}
        </div>
        <button type="submit"
          class="rounded bg-type-tv px-4 py-2 font-heading text-body font-semibold text-white transition active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-40">
          Change Password
        </button>
      </form>
    </div>

    <div class="rounded border border-border bg-bg-surface p-4">
      <h2 class="mb-2 text-heading font-heading">API Access</h2>
      <p class="mb-4 text-body text-text-secondary">Regenerating revokes the current API key immediately.</p>
      <form method="POST" action="/settings/api-key/regenerate" hx-post="/settings/api-key/regenerate" hx-target="body">
        <input type="hidden" name="_csrf" value="{{csrfToken}}" />
        <button type="submit"
          class="rounded bg-type-tv px-4 py-2 font-heading text-body font-semibold text-white transition active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-40">
          Regenerate API Key
        </button>
      </form>
    </div>
  </section>
  {{/if}}

  {{#if (eq activeTab 'providers')}}
  <section aria-labelledby="providers-heading" class="space-y-6">
    <div>
      <h2 id="providers-heading" class="text-heading font-heading">Provider Credentials</h2>
      <p class="mt-1 text-body text-text-secondary">Credentials are encrypted and cannot be viewed after saving.</p>
    </div>

    <div class="grid gap-4 lg:grid-cols-3">
      {{#each providerCredentials}}
      <article class="rounded border border-border bg-bg-surface p-4">
        <div class="mb-4 flex items-start justify-between gap-3">
          <div>
            <h3 class="text-subheading font-heading">{{this.label}}</h3>
            <p class="text-meta text-text-secondary">{{this.credentialLabel}}</p>
          </div>
          {{#if this.configured}}
          <span
            class="whitespace-nowrap rounded-full border border-green-500/40 bg-green-500/15 px-2 py-0.5 font-heading text-badge uppercase text-green-400">Configured</span>
          {{else}}
          <span
            class="whitespace-nowrap rounded-full border border-border bg-bg-elevated px-2 py-0.5 font-heading text-badge uppercase text-text-secondary">Not
            configured</span>
          {{/if}}
        </div>

        {{#if this.configured}}
        <form method="POST" action="/settings/provider-key/{{this.provider}}/remove" class="space-y-3"
          hx-post="/settings/provider-key/{{this.provider}}/remove" hx-target="body">
          <input type="hidden" name="_csrf" value="{{../csrfToken}}" />
          <label class="flex items-start gap-2 text-meta text-text-secondary">
            <input type="checkbox" name="confirmRemoval" value="yes" required class="mt-0.5 h-4 w-4 accent-red-600" />
            Confirm removal of these credentials
          </label>
          <button type="submit"
            class="rounded bg-red-600 px-3 py-2 font-heading text-body font-semibold text-white transition active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-40">
            Remove
          </button>
        </form>
        {{else}}
        {{#if (eq this.provider 'tmdb')}}
        <form method="POST" action="/settings/provider-key/tmdb" class="space-y-3">
          <input type="hidden" name="_csrf" value="{{../csrfToken}}" />
          <label for="tmdbKey" class="block text-subheading font-heading text-text-secondary">API key</label>
          <input type="password" id="tmdbKey" name="key" required autocomplete="off"
            class="w-full rounded border border-border bg-bg-elevated px-3 py-2 text-body text-text-primary focus:outline-none focus:ring-2 focus:ring-type-tv" />
          <button type="submit"
            class="rounded bg-type-game px-3 py-2 font-heading text-body font-semibold text-white disabled:cursor-not-allowed disabled:opacity-40">Save
            key</button>
        </form>
        {{/if}}
        {{#if (eq this.provider 'igdb')}}
        <form method="POST" action="/settings/provider-key/igdb" class="space-y-3">
          <input type="hidden" name="_csrf" value="{{../csrfToken}}" />
          <div>
            <label for="igdbClientId" class="mb-1 block text-subheading font-heading text-text-secondary">Client
              ID</label>
            <input type="text" id="igdbClientId" name="clientId" required autocomplete="off"
              class="w-full rounded border border-border bg-bg-elevated px-3 py-2 text-body text-text-primary focus:outline-none focus:ring-2 focus:ring-type-tv" />
          </div>
          <div>
            <label for="igdbClientSecret" class="mb-1 block text-subheading font-heading text-text-secondary">Client
              secret</label>
            <input type="password" id="igdbClientSecret" name="clientSecret" required autocomplete="off"
              class="w-full rounded border border-border bg-bg-elevated px-3 py-2 text-body text-text-primary focus:outline-none focus:ring-2 focus:ring-type-tv" />
          </div>
          <button type="submit"
            class="rounded bg-type-game px-3 py-2 font-heading text-body font-semibold text-white disabled:cursor-not-allowed disabled:opacity-40">Save
            credentials</button>
        </form>
        {{/if}}
        {{#if (eq this.provider 'bgg')}}
        <form method="POST" action="/settings/provider-key/bgg" class="space-y-3">
          <input type="hidden" name="_csrf" value="{{../csrfToken}}" />
          <label for="bggKey" class="block text-subheading font-heading text-text-secondary">API key</label>
          <input type="password" id="bggKey" name="key" required autocomplete="off"
            class="w-full rounded border border-border bg-bg-elevated px-3 py-2 text-body text-text-primary focus:outline-none focus:ring-2 focus:ring-type-boardgame" />
          <button type="submit"
            class="rounded bg-type-boardgame px-3 py-2 font-heading text-body font-semibold text-white disabled:cursor-not-allowed disabled:opacity-40">Save
            key</button>
        </form>
        {{/if}}
        {{/if}}
      </article>
      {{/each}}
    </div>

    <div class="rounded border border-border bg-bg-surface p-4">
      <h2 class="mb-2 text-heading font-heading">Provider Preferences</h2>
      <p class="mb-4 text-body text-text-secondary">Choose the metadata source used for each media type.</p>
      <form method="POST" action="/settings/metadata-providers" class="space-y-4">
        <input type="hidden" name="_csrf" value="{{csrfToken}}" />
        <div class="grid gap-4 md:grid-cols-2">
          {{#each providerPreferences}}
          <div>
            <label for="{{this.field}}"
              class="mb-1 block text-subheading font-heading text-text-secondary">{{this.label}}</label>
            <select id="{{this.field}}" name="{{this.field}}"
              class="w-full rounded border border-border bg-bg-elevated px-3 py-2 text-body text-text-primary focus:outline-none focus:ring-2 focus:ring-type-tv">
              {{#each this.options}}
              <option value="{{this.name}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
              {{/each}}
            </select>
          </div>
          {{/each}}
        </div>
        <button type="submit"
          class="rounded bg-type-tv px-4 py-2 font-heading text-body font-semibold text-white disabled:cursor-not-allowed disabled:opacity-40">Save
          preferences</button>
      </form>
    </div>
  </section>
  {{/if}}

  {{#if (eq activeTab 'maintenance')}}
  <section aria-labelledby="maintenance-heading">
    <div class="rounded border border-border bg-bg-surface p-4">
      <h2 id="maintenance-heading" class="mb-2 text-heading font-heading">Cache Management</h2>
      <p class="mb-4 text-body text-text-secondary">Clear cached history, dashboard statistics, and search indexes for
        this account.</p>
      <form method="POST" action="/settings/cache/clear" hx-post="/settings/cache/clear" hx-target="body">
        <input type="hidden" name="_csrf" value="{{csrfToken}}" />
        <button type="submit"
          class="rounded bg-red-600 px-4 py-2 font-heading text-body font-semibold text-white disabled:cursor-not-allowed disabled:opacity-40">Clear
          All Caches</button>
      </form>
    </div>
  </section>
  {{/if}}
</div>
