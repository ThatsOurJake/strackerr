<div class="mx-auto max-w-6xl">
  <h1 class="font-heading text-3xl font-extrabold tracking-tight">Collection</h1>
  {{#if success}}
  <p class="mt-4 rounded-lg border border-green-500/40 bg-green-500/15 px-4 py-3 text-sm text-green-400" role="status">
    {{success}}
  </p>
  {{/if}}
  {{#if error}}
  <p class="mt-4 rounded-lg border border-red-500/40 bg-red-500/15 px-4 py-3 text-sm text-red-400" role="alert">
    {{error}}
  </p>
  {{/if}}
  <div id="collection-browser">{{> collection_grid}}</div>
</div>
