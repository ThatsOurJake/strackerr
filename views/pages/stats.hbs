<div class="mx-auto max-w-6xl">
  <h1 class="font-heading text-3xl font-extrabold tracking-tight">Stats</h1>
  <p class="mt-2 text-sm text-text-secondary">{{periodRangeLabel}}</p>
  <nav class="mt-6 flex gap-2 overflow-x-auto pb-2" aria-label="Stats period">
    {{#each periods}}
    <a href="/stats?period={{slug}}"
      class="shrink-0 rounded-full border px-3 py-1.5 font-heading text-xs font-semibold {{#if active}}border-text-primary bg-text-primary text-bg-base{{else}}border-border-subtle bg-bg-surface text-text-secondary hover:bg-bg-elevated{{/if}}">{{label}}</a>
    {{/each}}
  </nav>

  {{#if hasActivity}}
  <div class="mt-8 grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(20rem,0.8fr)]">
    <section>
      <h2 class="mb-4 font-heading text-xl font-bold">Activity</h2>
      <div id="activity-chart" class="h-72 w-full" data-chart='{{chartJson}}'></div>
    </section>
    <section>
      <h2 class="mb-4 font-heading text-xl font-bold">Time by type</h2>
      <div class="grid gap-4">
        {{#each timeByType}}
        <div>
          <div class="mb-1.5 flex items-center justify-between gap-3 text-sm">
            <span class="flex items-center gap-2 font-heading font-semibold text-type-{{accent}}"><i
                data-lucide="{{icon}}" class="h-4 w-4"></i>{{label}}</span>
            <span class="text-text-secondary">{{duration}}</span>
          </div>
          <div class="h-2 bg-bg-elevated">
            <div class="h-full bg-type-{{accent}}" style="width: min(100%, calc({{minutes}} * 0.15%))"></div>
          </div>
        </div>
        {{/each}}
      </div>
    </section>
  </div>
  <section class="mt-8 grid gap-4 md:grid-cols-2">
    {{#if (eq period "this-week")}}
    {{#if weeklyNostalgia.hasData}}
    <a href="/stats/this-time-past-years"
      class="block rounded-lg border border-border-subtle bg-bg-surface p-4 hover:bg-bg-elevated focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-text-primary">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h2 class="font-heading text-base font-bold tracking-tight">{{weeklyNostalgia.title}}</h2>
        <span
          class="rounded-full border border-border-subtle bg-bg-elevated px-2 py-0.5 text-[11px] uppercase tracking-wide text-text-secondary">Open
          timeline</span>
      </div>

      {{#if weeklyNostalgia.subtitle}}
      <p class="mt-2 text-sm text-text-secondary">{{weeklyNostalgia.subtitle}}</p>
      {{/if}}

      <div class="mt-3 flex flex-wrap gap-2 text-xs">
        <span
          class="rounded-full border border-border-subtle bg-bg-elevated px-2 py-1 text-text-secondary">{{weeklyNostalgia.aggregateTotalDuration}}</span>
        {{#each weeklyNostalgia.typeTotals}}
        <span
          class="inline-flex items-center gap-1 rounded-full border border-border-subtle bg-bg-elevated px-2 py-1 text-text-secondary">
          <span class="h-2 w-2 rounded-full" style="background-color: {{color}};"></span>{{label}} {{duration}}
        </span>
        {{/each}}
      </div>

      {{#if weeklyNostalgia.throwbackItem}}
      <div class="mt-4 flex items-center gap-3 rounded-md border border-border-subtle bg-bg-elevated/60 p-2">
        {{#if (thumbnailUrl weeklyNostalgia.throwbackItem.imageUrl)}}
        <img data-image-fallback src="{{thumbnailUrl weeklyNostalgia.throwbackItem.imageUrl}}" alt=""
          class="h-14 w-10 rounded object-cover" />
        {{else}}
        <span
          class="flex h-14 w-10 items-center justify-center rounded bg-type-{{weeklyNostalgia.throwbackItem.accent}}/20 text-type-{{weeklyNostalgia.throwbackItem.accent}}"><i
            data-lucide="{{weeklyNostalgia.throwbackItem.icon}}" class="h-5 w-5"></i></span>
        {{/if}}
        <div class="min-w-0 flex-1">
          <p class="text-[11px] uppercase tracking-wide text-text-secondary">Throwback item</p>
          <p class="truncate font-heading text-sm font-bold text-text-primary">{{weeklyNostalgia.throwbackItem.title}}
          </p>
          <div class="mt-1 flex flex-wrap items-center gap-2 text-xs text-text-secondary">
            <span>{{weeklyNostalgia.throwbackItem.label}}</span>
            <span>{{weeklyNostalgia.throwbackItem.duration}}</span>
            <span>{{weeklyNostalgia.throwbackItem.dateLabel}}</span>
          </div>
        </div>
      </div>
      {{/if}}
    </a>
    {{/if}}
    {{/if}}

    <article class="rounded-lg border border-border-subtle bg-bg-surface p-4">
      <h2 class="font-heading text-base font-bold tracking-tight">Average session length by type</h2>
      <p class="mt-1 text-xs text-text-secondary">Based on logged sessions in this period</p>
      {{#if averageSessionDurationByType.length}}
      <div class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2 xl:grid-cols-3">
        {{#each averageSessionDurationByType}}
        <div class="rounded-md bg-bg-elevated p-3">
          <span class="flex min-w-0 items-center gap-2 font-heading text-sm font-semibold text-type-{{accent}}"><i
              data-lucide="{{icon}}" class="h-4 w-4 shrink-0"></i><span class="truncate">{{label}}</span></span>
          <span class="mt-2 block text-lg font-heading font-bold text-text-primary">{{value}}</span>
          <span class="mt-0.5 block text-xs text-text-secondary">{{subtitle}}</span>
        </div>
        {{/each}}
      </div>
      {{else}}
      <p class="mt-3 text-sm text-text-secondary">No sessions in this period yet.</p>
      {{/if}}
    </article>
  </section>

  <section class="mt-12">
    <h2 class="mb-4 font-heading text-xl font-bold">Top items</h2>
    <div class="divide-y divide-border-subtle border-y border-border-subtle">
      {{#each topItems}}
      <a href="{{detailUrl}}" class="flex items-center gap-3 px-2 py-3 hover:bg-bg-elevated">
        {{#if (thumbnailUrl imageUrl)}}<img data-image-fallback src="{{thumbnailUrl imageUrl}}" alt=""
          class="h-14 w-10 rounded object-cover" /><span
          class="hidden h-14 w-10 shrink-0 flex-col items-center justify-center rounded bg-type-{{accent}}/20 text-type-{{accent}}"><i
            data-lucide="{{icon}}" class="h-5 w-5"></i><span class="font-heading text-xs font-bold">{{initial
            title}}</span></span>{{else}}<span
          class="flex h-14 w-10 items-center justify-center rounded bg-type-{{accent}}/20 text-type-{{accent}}"><i
            data-lucide="{{icon}}" class="h-5 w-5"></i></span>{{/if}}
        <div class="min-w-0 flex-1">
          <h3 class="truncate font-heading font-bold">{{title}}</h3><span
            class="mt-1 inline-block rounded-full border border-type-{{accent}}/40 bg-type-{{accent}}/15 px-2 py-0.5 font-heading text-[11px] font-semibold uppercase tracking-wide text-type-{{accent}}">{{label}}</span>
        </div>
        <span class="shrink-0 text-sm text-text-secondary">{{duration}}</span>
      </a>
      {{/each}}
    </div>
  </section>
  {{else}}
  <div class="mt-8">{{> empty_stats}}</div>
  {{/if}}
</div>
