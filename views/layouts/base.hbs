<!doctype html>
<html lang="en" class="dark">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>STrackerr — {{title}}</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@400;500&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="/css/app.css" />
  <script src="/js/theme.js"></script>
  <script src="https://unpkg.com/htmx.org@2.0.10" defer></script>
  <script src="https://unpkg.com/echarts@6.1.0" defer></script>
  <script src="https://unpkg.com/lucide@1.33.0" defer></script>
</head>

<body data-csrf-token="{{csrfToken}}" class="min-h-screen overflow-x-hidden bg-bg-base font-body text-text-primary">
  <span id="global-htmx-indicator"
    class="htmx-indicator fixed right-4 top-4 z-50 rounded border border-border-subtle bg-bg-elevated p-2" role="status"
    aria-label="Loading">
    <span class="block h-5 w-5 animate-spin rounded-full border-2 border-text-muted border-t-type-game"></span>
  </span>
  {{#if user}}
  {{> flash}}
  <div class="min-h-screen md:flex">
    {{> nav}}
    <main class="min-h-screen min-w-0 flex-1 px-4 py-6 md:px-6 md:py-8">
      {{{body}}}
    </main>
  </div>
  {{else}}
  <main class="mx-auto flex min-h-screen max-w-4xl items-center justify-center px-4 py-8">
    {{{body}}}
  </main>
  {{/if}}
  <script src="/js/app.js" defer></script>
</body>

</html>
