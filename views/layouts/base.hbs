<!doctype html>
<html lang="en" class="dark" data-theme="dark">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>STrackerr — {{title}}</title>
  <link rel="icon" href="{{assetPath '/favicon.svg'}}" type="image/svg+xml" />
  <script src="{{assetPath '/js/theme.js'}}"></script>
  <link rel="stylesheet" href="{{assetPath '/css/app.css'}}" />
  <script src="{{assetPath '/vendor/htmx/htmx.min.js'}}" defer></script>
  <script src="{{assetPath '/vendor/echarts/echarts.min.js'}}" defer></script>
  <script src="{{assetPath '/vendor/lucide/lucide.min.js'}}" defer></script>
</head>

<body data-csrf-token="{{csrfToken}}" class="min-h-screen overflow-x-hidden bg-bg-base font-body text-text-primary">
  <span id="global-htmx-indicator"
    class="htmx-indicator fixed right-4 top-4 z-50 rounded border border-border-subtle bg-bg-elevated p-2" role="status"
    aria-label="Loading">
    <span class="block h-5 w-5 animate-spin rounded-full border-2 border-text-muted border-t-type-game"></span>
  </span>
  {{#if user}}
  {{> flash}}
  <div class="min-h-screen md:flex">
    {{> nav}}
    <main class="min-h-screen min-w-0 flex-1 px-4 py-6 md:px-6 md:py-8">
      {{{body}}}
    </main>
  </div>
  {{else}}
  <main class="mx-auto flex min-h-screen max-w-4xl items-center justify-center px-4 py-8">
    {{{body}}}
  </main>
  {{/if}}
  <script type="module" src="{{assetPath '/js/app.js'}}"></script>
</body>

</html>
